{
  "info": {
    "_postman_id": "campushub-api-collection-v1",
    "name": "CampusHub Backend API (Course Plan 24CAI0303)",
    "description": "Comprehensive Postman test collection for CampusHub REST API covering Node.js, Express, MongoDB, JWT Auth, Multer File Uploads, and Streaming.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "System & Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/health",
              "host": ["{{base_url}}"],
              "path": ["api", "health"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('System reports healthy', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.status).to.eql('healthy');",
                  "    pm.expect(json).to.have.property('nodeRuntime');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Curriculum Topics Coverage",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/topics",
              "host": ["{{base_url}}"],
              "path": ["api", "topics"]
            }
          }
        }
      ]
    },
    {
      "name": "Authentication (JWT & bcrypt)",
      "item": [
        {
          "name": "Register User (Signup)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Rohan Mehta\",\n  \"email\": \"rohan.mehta@campushub.edu\",\n  \"password\": \"password123\",\n  \"role\": \"student\",\n  \"department\": \"Computer Science & AI\",\n  \"semester\": 4\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/signup",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "signup"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const json = pm.response.json();",
                  "    pm.environment.set('auth_token', json.token);",
                  "    pm.test('Received JWT Token', function () {",
                  "        pm.expect(json.token).to.be.a('string');",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"rohan.mehta@campushub.edu\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const json = pm.response.json();",
                  "    pm.environment.set('auth_token', json.token);",
                  "    pm.test('Token auto-saved to environment', function () {",
                  "        pm.expect(json.token).to.be.a('string');",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Current User Profile (Protected)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/auth/me",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "me"]
            }
          }
        }
      ]
    },
    {
      "name": "Subjects (CRUD & Query Filtering)",
      "item": [
        {
          "name": "Get All Subjects",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/subjects?semester=4",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "subjects"],
              "query": [
                { "key": "semester", "value": "4" }
              ]
            }
          }
        },
        {
          "name": "Get Subject by Code or ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/subjects/{{demo_subject_code}}",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "subjects", "{{demo_subject_code}}"]
            }
          }
        },
        {
          "name": "Create Subject (Admin/Faculty)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"CS401\",\n  \"name\": \"Operating Systems\",\n  \"department\": \"Computer Science & AI\",\n  \"semester\": 4,\n  \"credits\": 4,\n  \"description\": \"Process scheduling, threads, virtual memory, synchronization and file systems.\",\n  \"color\": \"#0ea5e9\",\n  \"tags\": [\"OS\", \"Concurrency\", \"Processes\", \"Paging\"]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/subjects",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "subjects"]
            }
          }
        }
      ]
    },
    {
      "name": "Notes & Study Material",
      "item": [
        {
          "name": "Get All Notes (Search & Pagination)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/notes?page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "notes"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Create Note (JSON Body)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"CPU Scheduling Algorithms - Unit 2 Summary\",\n  \"description\": \"Comprehensive notes on FCFS, SJF, Round Robin and Priority scheduling with solved numericals.\",\n  \"subject\": \"6626f8d09a27c134015f8a01\",\n  \"unit\": 2,\n  \"tags\": [\"CPU\", \"Scheduling\", \"SJF\", \"Round Robin\"]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/notes",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "notes"]
            }
          }
        },
        {
          "name": "Create Note With File Upload (Multer Multipart)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "title", "value": "Memory Management Lecture Notes", "type": "text" },
                { "key": "description", "value": "Paging, segmentation, TLB and page replacement algorithms.", "type": "text" },
                { "key": "subject", "value": "6626f8d09a27c134015f8a01", "type": "text" },
                { "key": "unit", "value": "3", "type": "text" },
                { "key": "file", "type": "file", "src": "" }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/v1/notes/with-file",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "notes", "with-file"]
            }
          }
        },
        {
          "name": "Like Note",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/notes/{{demo_note_id}}/like",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "notes", "{{demo_note_id}}", "like"]
            }
          }
        }
      ]
    },
    {
      "name": "Resources & Streams (Upload & Download)",
      "item": [
        {
          "name": "Upload Study Material Document (Multer)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": "" }
              ]
            },
            "url": {
              "raw": "{{base_url}}/api/v1/resources/upload",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "resources", "upload"]
            }
          }
        },
        {
          "name": "Stream Download Resource (Node Streams)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/resources/download/sample_notes.pdf",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "resources", "download", "sample_notes.pdf"]
            }
          }
        },
        {
          "name": "Get File Info / Stats (fs.stat)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/resources/info/sample_notes.pdf",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "resources", "info", "sample_notes.pdf"]
            }
          }
        }
      ]
    },
    {
      "name": "Bookmarks",
      "item": [
        {
          "name": "Get My Bookmarks",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/bookmarks",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "bookmarks"]
            }
          }
        },
        {
          "name": "Toggle Note Bookmark",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{auth_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"noteId\": \"{{demo_note_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/bookmarks/toggle",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "bookmarks", "toggle"]
            }
          }
        }
      ]
    }
  ]
}
