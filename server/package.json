{
  "name": "campushub-backend",
  "version": "1.0.0",
  "description": "Backend API and core services for CampusHub platform",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "demo:core": "node demo/node-core-demo.js",
    "demo:http": "node demo/raw-http.js",
    "demo:db": "node scripts/demo-db.js",
    "seed": "node scripts/seed.js",
    "test:api": "node tests/api-test.js",
    "test": "node --test tests/regression.test.js",
    "db:start": "node scripts/start-local-db.js",
    "prestart": "node scripts/start-local-db.js --optional",
    "predev": "node scripts/start-local-db.js --optional"
  },
  "keywords": [
    "nodejs",
    "express",
    "mongodb",
    "campushub",
    "rest-api"
  ],
  "author": "CampusHub Team",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-validator": "^7.3.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.3",
    "morgan": "^1.10.0",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.9"
  }
}
