# Copy to server/.env. Never commit that file.
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/campushub
# Generate your own value: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
MAX_FILE_SIZE_MB=10
# Leave blank for same-origin frontend hosting.
FRONTEND_ORIGIN=
# Optional OpenAI-compatible Chat Completions provider. Base URL must include its API version path.
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
